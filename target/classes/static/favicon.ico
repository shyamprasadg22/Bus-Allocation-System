<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <rect width="64" height="64" rx="8" fill="#0f2744"/>
  <rect x="12" y="14" width="40" height="34" rx="6" fill="#1e3a5f" stroke="#ffffff" stroke-width="2"/>
  <!-- Windshield -->
  <rect x="16" y="18" width="32" height="12" rx="3" fill="#ffffff" opacity="0.9"/>
  <!-- Headlights -->
  <circle cx="20" cy="38" r="3" fill="#fbbf24"/>
  <circle cx="44" cy="38" r="3" fill="#fbbf24"/>
  <!-- Grill lines -->
  <line x1="28" y1="36" x2="36" y2="36" stroke="#ffffff" stroke-width="2"/>
  <line x1="28" y1="40" x2="36" y2="40" stroke="#ffffff" stroke-width="2"/>
  <!-- Wheels -->
  <rect x="16" y="48" width="8" height="6" rx="2" fill="#334155"/>
  <rect x="40" y="48" width="8" height="6" rx="2" fill="#334155"/>
</svg>
